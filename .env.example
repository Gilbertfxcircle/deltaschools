# ============================================================================
# Delta Plax Education Suite - Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================================

# ---- Database ----
# Cloud / large schools: PostgreSQL 15. Local EXE deployments use SQLite.
DATABASE_URL=postgresql+psycopg://deltaplax:deltaplax@localhost:5432/deltaplax
# For local/offline (SQLite) deployments instead:
# DATABASE_URL=sqlite+pysqlite:///./local_data/deltaplax.sqlite3

# ---- Delta Plax Super Admin (pre-created on bootstrap; NOT publicly registerable) ----
DELTAPLAX_ADMIN_EMAIL=admin@deltaplax.com
DELTAPLAX_ADMIN_PASSWORD=change-me-to-a-strong-password

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-256-bit-random-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"  (must be 32 bytes for AES-256)
ENCRYPTION_KEY=replace-with-aes-256-key
# Auth rate limiting
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# ---- App ----
ENVIRONMENT=development
ROOT_DOMAIN=deltaplax.com
API_V1_PREFIX=/api/v1
# Comma-separated CORS origins (frontend dev server, school LAN, etc.)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Storage (MinIO / S3-compatible) ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=deltaplax
MINIO_SECURE=false

# ---- Task queue ----
REDIS_URL=redis://localhost:6379/0

# ---- AI (optional; features degrade gracefully when unset) ----
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# ---- SMS (optional) ----
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_SENDER_ID=DELTAPLAX

# ---- Payment Gateways (optional) ----
MTN_MOMO_API_KEY=
AIRTEL_MONEY_API_KEY=

# ---- Offline sync engine (local server only) ----
CLOUD_SYNC_URL=https://api.deltaplax.com
SYNC_POLL_SECONDS=30
