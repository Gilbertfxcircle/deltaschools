# Frontend environment variables (Vite exposes VITE_* to the client).

# Base path for API calls. In dev, leave as /api and let Vite proxy to the
# backend. In production the SPA is served same-origin behind Nginx.
VITE_API_BASE_URL=/api/v1

# Dev-only: where Vite proxies /api during `npm run dev`.
VITE_API_TARGET=http://localhost:8000

# Optional: hard-code a tenant for local testing when not using a subdomain.
# Normally the tenant is derived from the subdomain (stmarys.deltaplax.com).
VITE_DEFAULT_TENANT=
